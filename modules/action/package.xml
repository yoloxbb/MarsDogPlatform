<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>marsdog_action_executor</name>
  <version>0.1.0</version>
  <description>MarsDog bionic robot dog behavior execution engine — converts behavior_name goals into staged action plans and drives execution.</description>
  <maintainer email="dev@marsdog.local">MarsDog Dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>marsdog_voice_interaction</depend>
  <depend>marsdog_vision_interaction</depend>
  <exec_depend>unitree_api</exec_depend>
  <exec_depend>unitree_go</exec_depend>
  <exec_depend>transfer_interfaces</exec_depend>

  <!-- Public type selected by the integrated profile; local fallback remains. -->
  <exec_depend>marsdog_interfaces</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <exec_depend>marsdog_observability</exec_depend>
</package>
