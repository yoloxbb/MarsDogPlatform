# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Test/type/lint cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Python packaging
build/
dist/
*.egg-info/

# ROS2/colcon generated output
install/
log/

# Local editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example

# Runtime logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Generated or local-only documentation artifacts.
# Markdown 文档默认纳入版本控制；只忽略表格、截图和二进制导出文件。
docs/*.csv
docs/*.xls
docs/*.xlsx
docs/*.docx
docs/*.pptx
docs/*.pdf
docs/*.drawio
docs/*.png
docs/*.jpg
docs/*.jpeg
