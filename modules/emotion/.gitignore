# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Test/type/lint cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Python packaging
build/
dist/
*.egg-info/

# ROS2/colcon generated output
install/
log/

# Local editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example

# Runtime logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Generated or local-only documentation artifacts.
# Tracked docs are still tracked; these rules mainly prevent new handoff drafts,
# spreadsheets, screenshots, and exported documents from being added by mistake.
docs/*.md
docs/*.csv
docs/*.xls
docs/*.xlsx
docs/*.docx
docs/*.pptx
docs/*.pdf
docs/*.drawio
docs/*.png
docs/*.jpg
docs/*.jpeg

# Keep interface docs that are useful for team integration.
!docs/api.md
!docs/current_implementation_summary.md
!docs/internal_need_emotion_update_logic.md
!docs/ros2_topic_contract.md
!docs/time_compression_test_guide.md
