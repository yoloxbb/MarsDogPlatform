<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Project-wide Fast DDS transport profile for the MarsDog image pipeline.

  Fast DDS 2.6.x limits UDP maxMessageSize to 65500 bytes. The 8 MiB
  max-message setting therefore applies to local shared memory transport;
  UDP uses RTPS fragmentation for larger samples. The socket buffer values
  are requests and can be capped by Linux net.core.{r,w}mem_max.
-->
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>marsdog_udp</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>8388608</sendBufferSize>
        <receiveBufferSize>8388608</receiveBufferSize>
        <maxMessageSize>65500</maxMessageSize>
        <non_blocking_send>true</non_blocking_send>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>marsdog_shm</transport_id>
        <type>SHM</type>
        <maxMessageSize>8388608</maxMessageSize>
        <segment_size>33554432</segment_size>
        <port_queue_capacity>512</port_queue_capacity>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="marsdog_8mib" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>marsdog_shm</transport_id>
          <transport_id>marsdog_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
